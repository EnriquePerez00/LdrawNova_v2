#!/usr/bin/env direnv allow
# Auto-activate Python virtual environment
source_up_if_exists

if [ -f .venv/bin/activate ]; then
  source .venv/bin/activate
fi

# Load .env if present
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

# Set LDRAW_DIR to the LDraw library
export LDRAW_DIR="${LDRAW_DIR:-$HOME/LDraw}"
export PATH="$HOME/.local/bin:$PATH"

# Show status
echo "✓ ldraw-nova environment activated"
echo "  LDRAW_DIR=$LDRAW_DIR"
echo "  Gemini API: configured (${GEMINI_MODEL:-gemini-3.8-flash})"
echo "  Python: $(python --version 2>&1)"
