# ============================================================================
# Dataset Configuration — LegoGPT Data Access
# ============================================================================

#: Path to LegoGPT/data/normalized_io (927 .io step-aware assembly files).
#: Leave unset to auto-resolve via LegoGPT sibling repo or data_locator module.
#: Set explicitly to override (e.g., for CI or isolated testing).
#: 
#: Resolution strategy (config.py _resolve_io_source_dir):
#:   1. LDRAW_NOVA_IO_DIR env var (if set)
#:   2. LegoGPT sibling repo ../LegoGPT/data/normalized_io (if exists)
#:   3. Hardcoded fallback /Users/I764690/Code_personal/LegoGPT/data/normalized_io
# 
# LDRAW_NOVA_IO_DIR="/path/to/LegoGPT/data/normalized_io"

# ============================================================================
 # Google AI Studio API Configuration
# Google AI Studio API Configuration
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
LDRAW_DIR="$HOME/LDraw"

# Improvement Loop: Proxy Cline LiteLLM (VLM + Code Models)
# LiteLLM endpoint: http://localhost:6655/litellm/v1
LLM_PROVIDER="llmproxy"
LLM_BASE_URL="http://localhost:6655/litellm"
LLM_SECRET=""

# Improvement Loop Models
# A1 (Descriptor GT, VLM): describe ground truth images → spec.json
LLM_A1_MODEL="gemini-2.5-flash"

# A2 (Designer 3D, code generation): generate plan.json + .mpd
LLM_A2_MODEL="claude-haiku-5"

# A3 (Descriptor Blind, VLM): describe renders without GT reference → render_spec.json
LLM_A3_MODEL="gemini-2.5-flash"

# A4 (Judge/Differ, VLM): compare GT vs render → diff_report.json
LLM_A4_MODEL="gemini-2.5-flash"

# VLM Fallback (local Ollama)
LLM_VLM_FALLBACK_MODEL="llama3.2-vision:11b"
LLM_VLM_FALLBACK_BASE_URL="http://127.0.0.1:11434"
